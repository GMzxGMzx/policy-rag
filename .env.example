# ---------- 路径 ----------
# 政策原文放这里（.txt / .md / .pdf / .docx 均可）
RAW_DIR=./data/raw

# ---------- 切分 ----------
# 单条超过该字数时按“（一）（二）”项拆分，避免长条款稀释检索
MAX_CLAUSE_CHARS=900
# 条款正文短于该字数时不做特殊处理，仅打标
MIN_BODY_CHARS=20

# ---------- 检索 ----------
RETRIEVE_TOP_K=20
RERANK_TOP_N=8
RRF_K=60
CONTEXT_TOP_N=5
BM25_K1=1.5
BM25_B=0.75

# ---------- Embedding ----------
# hash   : 无依赖的哈希词袋向量，仅用于跑通流程/联调，不含语义（默认）
# openai : 任何 OpenAI 兼容的 /embeddings 接口（硅基流动、阿里百炼、vLLM、TEI、Ollama 均可）
# local  : 本地 sentence-transformers 加载 BGE-M3
EMBED_PROVIDER=hash
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH=16

# ---------- 重排（可选，开启后效果通常 +10% 以上命中率） ----------
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 大模型 ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90
